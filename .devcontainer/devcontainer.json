{
    "name": "OPOPO demo",
    "image": "mcr.microsoft.com/devcontainers/base:bookworm",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "hostRequirements": {
        "cpus": 2,
        "memory": "8gb"
    },
    "postStartCommand": "nohup bash .devcontainer/start-demo.sh >/dev/null 2>&1 &",
    "forwardPorts": [
        8000
    ],
    "portsAttributes": {
        "8000": {
            "label": "OPOPO demo",
            "onAutoForward": "notify"
        }
    },
    "postAttachCommand": "bash .devcontainer/show-links.sh"
}
