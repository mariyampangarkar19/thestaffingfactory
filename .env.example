APP_NAME="Staffing Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tsf.staffing.test:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=staffing
# Web app role: NOT the table owner, no BYPASSRLS (see docs/adr/0002-tenant-isolation.md)
DB_USERNAME=sp_app
DB_PASSWORD=app_pw
# Owns the schema; used only for migrations
DB_OWNER_USERNAME=sp_owner
DB_OWNER_PASSWORD=owner_pw
# Super-admin panel role (BYPASSRLS)
DB_PLATFORM_USERNAME=sp_platform
DB_PLATFORM_PASSWORD=platform_pw
DB_SSLMODE=prefer

PLATFORM_NAME="Staffing Platform"
PLATFORM_BASE_DOMAIN=staffing.test
PLATFORM_ADMIN_SUBDOMAIN=admin
TRUSTED_PROXIES=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
